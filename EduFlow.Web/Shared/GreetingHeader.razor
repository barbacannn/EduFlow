@implements IDisposable

<div class="space-y-2">
    <h1 class="text-4xl md:text-5xl font-bold">
        @GetGreeting(), Student 👋
    </h1>
    <div class="flex flex-wrap gap-4 text-muted-foreground">
        <div class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>@CurrentTime.ToString("dddd, MMMM d, yyyy")</span>
        </div>
        <div class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>@CurrentTime.ToString("h:mm tt")</span>
        </div>
    </div>
</div>

@code {
    private DateTime CurrentTime = DateTime.Now;
    private Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new Timer(UpdateTime, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void UpdateTime(object? state)
    {
        CurrentTime = DateTime.Now;
        InvokeAsync(StateHasChanged);
    }

    private string GetGreeting()
    {
        var hour = CurrentTime.Hour;
        if (hour < 12) return "Good morning";
        if (hour < 18) return "Good afternoon";
        return "Good evening";
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
