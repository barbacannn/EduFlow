@inherits LayoutComponentBase

<div class="min-h-screen flex w-full bg-gradient-to-br from-background via-background to-primary/5">
    <div class="sidebar w-64 bg-card border-r border-border flex flex-col">
        <div class="flex items-center gap-2 p-4 border-b border-border">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary to-accent flex items-center justify-center">
                <span class="text-primary-foreground font-bold text-lg">E</span>
            </div>
            <span
                class="text-xl font-bold bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">EduFlow</span>
        </div>
        <NavMenu />
    </div>

    <div class="flex-1 flex flex-col w-full">
        <header
            class="h-14 border-b border-border bg-card/50 backdrop-blur-sm sticky top-0 z-40 flex items-center px-4">
            <div class="flex-1" />
        </header>

        <main class="flex-1 overflow-auto p-6">
            @Body
        </main>
    </div>
</div>